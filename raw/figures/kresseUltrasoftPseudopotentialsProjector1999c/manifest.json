      "page": "-"
    },
    {
      "id": "eq8",
      "title": "Equation 8",
      "content": "$$n_{Zc} = n_Z + n_c. \\quad (8)$$",
      "page": "-"
    },
    {
      "id": "eq9",
      "title": "Equation 9",
      "content": "$$\\int_{V_r} n_{Zc}(r) d^3r = \\int_{V_r} \\tilde{n}_{Zc}(r) dr, \\quad (9)$$",
      "page": "-"
    },
    {
      "id": "eq10",
      "title": "Equation 10",
      "content": "$$n_T = \\tilde{n}_T + (n_{1T} - \\tilde{n}_{1T}) + \\hat{n}, \\quad (10)$$",
      "page": "-"
    },
    {
      "id": "eq11",
      "title": "Equation 11",
      "content": "$$\\frac{1}{2} \\langle n_T | n_T \\rangle = \\frac{1}{2} \\langle \\tilde{n}_T | \\tilde{n}_T \\rangle + \\langle n_T - \\tilde{n}_T | \\tilde{n}_T \\rangle + \\frac{1}{2} \\langle n_T - \\tilde{n}_T | n_T - \\tilde{n}_T \\rangle, \\quad (11)$$",
      "page": "-"
    },
    {
      "id": "eq12",
      "title": "Equation 12",
      "content": "$$\\langle a | b \\rangle = \\int dr dr' \\frac{a(r)b(r')}{|r-r'|}. \\quad (12)$$",
      "page": "-"
    },
    {
      "id": "eq13",
      "title": "Equation 13",
      "content": "$$\\langle n_{1T} - \\tilde{n}_{1T} | \\tilde{n}_T - \\tilde{n}_{1T} \\rangle. \\quad (13)$$",
      "page": "-"
    },
    {
      "id": "eq14",
      "title": "Equation 14",
      "content": "$$\\frac{1}{2} \\langle \\tilde{n}_T | \\tilde{n}_T \\rangle - \\frac{1}{2} \\langle \\tilde{n}_{1T} | \\tilde{n}_{1T} \\rangle + \\frac{1}{2} \\langle n_{1T} | n_{1T} \\rangle. \\quad (14)$$",
      "page": "-"
    },
