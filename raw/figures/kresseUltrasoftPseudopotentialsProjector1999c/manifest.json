  "formulas": [
    {
      "id": "eq1",
      "title": "Equation 1",
      "content": "$$E = \\sum_{n} f_n \\langle \\psi_n | -\\frac{1}{2} \\nabla^2 | \\psi_n \\rangle + E_H[n + n_Z] + E_{xc}[n]. \\quad (1)$$",
      "page": "-"
    },
    {
      "id": "eq2",
      "title": "Equation 2",
      "content": "$$\\langle \\psi_n \\rangle = \\langle \\tilde{\\psi}_n \\rangle + \\sum_{i,j} \\langle \\tilde{\\psi}_n | \\tilde{p}_i \\rangle ( | \\phi_i \\rangle - | \\tilde{\\phi}_i \\rangle ) \\langle \\tilde{p}_j | \\tilde{\\psi}_n \\rangle. \\quad (2)$$",
      "page": "-"
    },
    {
      "id": "eq3",
      "title": "Equation 3",
      "content": "$$n(r) = \\tilde{n}(r) + \\sum_i [n_i(r) - \\tilde{n}_i(r)], \\quad (3)$$",
