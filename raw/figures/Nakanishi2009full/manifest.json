    {
      "id": "eq1",
      "title": "Equation 1",
      "content": "$$ \\text{光子对的时间关联} \\xrightarrow{\\text{影响}} \\text{双光子波函数} \\xrightarrow{\\text{通过}} \\text{时序双光子波函数} \\xrightarrow{\\text{决定}} \\text{双光子吸收概率} $$",
      "page": "-"
    },
    {
      "id": "eq2",
      "title": "Equation 2",
      "content": "$$ \\text{同时，光子对纠缠特性} \\xrightarrow{\\text{影响}} \\text{单光子频谱} \\xrightarrow{\\text{决定}} \\text{单光子吸收概率} $$",
      "page": "-"
    },
    {
      "id": "eq3",
      "title": "Equation 3",
      "content": "$$ \\text{结论：通过调控时间关联，可使两者解耦，实现高效、纯净的双光子吸收。} $$",
      "page": "-"
    }
