formulas:
  first_image: file.embeds.filter(value.containsAny("png","jpg","webp","svg","jpeg"))[0]
  firsr_image: file.embeds.filter(value.containsAny("png","jpg","webp","svg","jpeg"))[0]
views:
  - type: table
    name: 文献矩阵
    filters:
      and:
        - file.folder == "科研Wiki/wiki/papers"
    order:
      - file.name
      - file.backlinks
      - file.embeds
      - file.links
      - file.tags
      - file.size
      - "对领域的贡献:"
      - "领域基础知识:"
      - "未来研究方向思考:"
      - "未来研究方向提及:"
      - "研究背景:"
      - "研究结论:"
      - "研究意义:"
      - "主要研究对象:"
      - "主要研究方法:"
      - "作者的问题意识:"
      - authors
      - concepts
      - doi
      - entities
      - figures
      - journal
      - materials
      - methods
      - paper_type
      - projects
      - tags
      - title
      - title_zh
      - url
      - year
    rowHeight: extra
  - type: cards
    name: 概念图
    filters:
      and:
        - file.folder == "科研Wiki/wiki/concepts"
    order:
      - file.name
      - status
    sort:
      - property: file.size
        direction: DESC
    image: formula.first_image
  - type: cards
    name: 文献表
    filters:
      and:
        - file.folder == "科研Wiki/wiki/papers"
    order:
      - file.name
    image: formula.first_image
  - type: cards
    name: 概念卡片
    filters:
      or:
        - file.folder == "科研Wiki/wiki/concepts"
        - file.folder == "科研Wiki/wiki/entities"
    groupBy:
      property: file.size
      direction: DESC
    order:
      - file.name
